/dts-v1/;

#include <dt-bindings/leds/common.h>
#include "imx8mn.dtsi"

/ {
	model = "TQ-Systems i.MX8MN EG4XX";
	compatible = "tq,imx8mn-eg4xx", "fsl,imx8mn";
	chassis-type = "embedded";

	aliases {
		mmc0 = &usdhc3;
		rtc0 = &pcf85063;
		rtc1 = &snvs_rtc;
	};

	chosen {
		stdout-path = &uart1;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpiobutton>;
		autorepeat;

		switch-1 {
			label = "S800";
			linux,code = <BTN_0>;
			gpios = <&gpio4 31 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpioled>;

		/* LED1_GN */
		led-0 {
			label = "energymanager:green:status";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <0>;
			gpios = <&gpio5 2 GPIO_ACTIVE_HIGH>;
		};

		/* LED1_RD */
		led-1 {
			label = "energymanager:red:status";
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <1>;
			gpios = <&gpio5 3 GPIO_ACTIVE_HIGH>;
		};

		/* LED2_GN */
		led-2 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <2>;
			gpios = <&gpio5 4 GPIO_ACTIVE_HIGH>;
		};

		/* LED2_RD */
		led-3 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <3>;
			gpios = <&gpio5 5 GPIO_ACTIVE_HIGH>;
		};

		/* LED3_GN */
		led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <4>;
			gpios = <&gpio5 28 GPIO_ACTIVE_HIGH>;
		};

		/* LED3_RD */
		led-5 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <5>;
			gpios = <&gpio5 29 GPIO_ACTIVE_HIGH>;
		};
	};

	mdio_gpio0: mdio {
		compatible = "microchip,mdio-smi0";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_fec1smi>,
			    <&pinctrl_fec1phy>;

		gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>,
			<&gpio1 17 GPIO_ACTIVE_HIGH>;

		switch@0 {
			compatible = "microchip,ksz8863";
			reg = <0>;
			interrupt-parent = <&gpio1>;
			interrupts = <29 IRQ_TYPE_LEVEL_LOW>;
			reset-gpios = <&gpio1 28 GPIO_ACTIVE_LOW>;
			microchip,io-drive-strength-microamp = <8000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				lan0: port@0 {
					reg = <0>;
					label = "lan0";
					phy-mode = "internal";
				};

				lan1: port@1 {
					reg = <1>;
					label = "lan1";
					phy-mode = "internal";
				};

				port@2 {
					reg = <2>;
					label = "cpu";
					ethernet = <&fec1>;
					phy-mode = "rmii";
					microchip,rmii-clk-internal;

					fixed-link {
						speed = <100>;
						full-duplex;
					};
				};
			};
		};
	};

	memory@40000000 {
		device_type = "memory";
		/*  RAM size 512 MiB */
		reg = <0x00000000 0x40000000 0 0x20000000>;
	};
};

&A53_0 {
	cpu-supply = <&buck2_reg>;
};

&ecspi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi1>;
	cs-gpios = <&gpio5 17 GPIO_ACTIVE_LOW>;

	/* WILCS02PE SPI WiFi module, not placed */
};

&ecspi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2>;

	tpm@0 {
		compatible = "infineon,slb9670", "tcg,tpm_tis-spi";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tpm>;
		reg = <0>;

		reset-gpios = <&gpio5 16 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio5>;
		interrupts = <18 IRQ_TYPE_LEVEL_LOW>;

		status = "disabled"; /* Not placed */
	};
};

&fec1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec1>;
	phy-connection-type = "rmii";
	status = "okay";

	fixed-link {
		speed = <100>;
		full-duplex;
	};
};

&gpio1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio1>;

	gpio-line-names = "IS_EG4XX", "", "WDOG#", "",		/*  0 ..  3 */
			  "", "", "", "",			/*  4 ..  7 */
			  "IRQ#", "", "USB_ID", "",		/*  8 .. 11 */
			  "energymanager:vbus:enable", "energymanager:vbus:fault#", "", "",	/* 12 .. 15 */
			  "", "", "", "",			/* 16 .. 19 */
			  "", "", "", "",			/* 20 .. 23 */
			  "", "", "", "",			/* 24 .. 27 */
			  "", "", "", "";			/* 28 .. 31 */

	usb-id-hog {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "USB_ID";
	};
};

&gpio4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio4>;

	gpio-line-names = "", "", "", "",				/*  0 ..  3 */
			  "", "", "", "",				/*  4 ..  7 */
			  "", "", "", "",				/*  8 .. 11 */
			  "", "", "", "",				/* 12 .. 15 */
			  "", "", "", "",				/* 16 .. 19 */
			  "", "ZIGBEE_RESET#", "HW.VER0", "HW.VER1",	/* 20 .. 23 */
			  "HW.VER2", "HW.VER3", "", "HW.REV0",		/* 24 .. 27 */
			  "HW.REV1", "", "HW.REV2", "BUTTON#";		/* 28 .. 31 */
};

&gpio5 {
	gpio-line-names = "", "", "LED1_GN", "LED1_RD",		/*  0 ..  3 */
			  "LED2_GN", "LED2_RD", "", "",		/*  4 ..  7 */
			  "", "", "", "",			/*  8 .. 11 */
			  "", "", "", "",			/* 12 .. 15 */
			  "TPM_RST#", "", "TPM_PIRQ#", "MCLR#",	/* 16 .. 19 */
			  "INTOUT", "", "", "",			/* 20 .. 23 */
			  "", "", "", "",			/* 24 .. 27 */
			  "LED3_GN", "LED3_RD", "", "";		/* 28 .. 31 */
};

&i2c1 {
	clock-frequency = <100000>;
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_i2c1>;
	pinctrl-1 = <&pinctrl_i2c1_gpio>;
	scl-gpios = <&gpio5 14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	sda-gpios = <&gpio5 15 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	status = "okay";

	pca9450: pmic@25 {
		compatible = "nxp,pca9450b";
		reg = <0x25>;

		/* PMIC PCA9450 PMIC_nINT GPIO1_IO08 */
		pinctrl-0 = <&pinctrl_pmic>;
		pinctrl-names = "default";
		interrupt-parent = <&gpio1>;
		interrupts = <8 IRQ_TYPE_LEVEL_LOW>;

		regulators {
			/* V_0V85_SOC: 0.85 .. 0.95 */
			buck1_reg: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <950000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			/* V_0V85_ARM */
			buck2_reg: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <1000000>;
				regulator-boot-on;
				regulator-always-on;
				nxp,dvs-run-voltage = <950000>;
				nxp,dvs-standby-voltage = <850000>;
				regulator-ramp-delay = <3125>;
			};

			/* V_3V3 -> VMMC, ... must not be changed */
			buck4_reg: BUCK4 {
				regulator-name = "BUCK4";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* V_1V8 -> VQMMC, ... must not be changed */
			buck5_reg: BUCK5 {
				regulator-name = "BUCK5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* V_1V1 -> RAM, ... must not be changed */
			buck6_reg: BUCK6 {
				regulator-name = "BUCK6";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* V_1V8_SNVS */
			ldo1_reg: LDO1 {
				regulator-name = "LDO1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* V_0V8_SNVS */
			ldo2_reg: LDO2 {
				regulator-name = "LDO2";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <850000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* V_1V8_ANA */
			ldo3_reg: LDO3 {
				regulator-name = "LDO3";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* not used */
			ldo5_reg: LDO5 {
				regulator-name = "LDO5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};
		};
	};

	pcf85063: rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
		quartz-load-femtofarads = <7000>;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
	assigned-clocks = <&clk IMX8MN_CLK_UART2>;
	assigned-clock-parents = <&clk IMX8MN_SYS_PLL1_80M>;
	linux,rs485-enabled-at-boot-time;
	uart-has-rtscts;
	status = "okay";
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	assigned-clocks = <&clk IMX8MN_CLK_UART3>;
	assigned-clock-parents = <&clk IMX8MN_SYS_PLL1_80M>;
	uart-has-rtscts;
	status = "okay";
};

&usdhc3 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc3>;
	pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
	bus-width = <8>;
	non-removable;
	no-sd;
	no-sdio;
	vmmc-supply = <&buck4_reg>;
	vqmmc-supply = <&buck5_reg>;
	status = "okay";
};

/*
 * Attention:
 * wdog reset is routed to PMIC, PMIC must be preconfigured to force POR
 * without LDO for SNVS. GPIO1_IO02 must not be used as GPIO.
 */
&wdog1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdog>;
	fsl,ext-reset-output;
	status = "okay";
};

&iomuxc {
	pinctrl_ecspi1: ecspi1grp {
		fsl,pins = <MX8MN_IOMUXC_ECSPI1_SCLK_ECSPI1_SCLK	0x0>,
			   <MX8MN_IOMUXC_ECSPI1_MOSI_ECSPI1_MOSI	0x40000040>,
			   <MX8MN_IOMUXC_ECSPI1_MISO_ECSPI1_MISO	0x0>,
			   <MX8MN_IOMUXC_I2C2_SDA_GPIO5_IO17		0x0>;
	};

	pinctrl_ecspi2: ecspi2grp {
		fsl,pins = <MX8MN_IOMUXC_ECSPI2_SCLK_ECSPI2_SCLK	0x0>,
			   <MX8MN_IOMUXC_ECSPI2_MOSI_ECSPI2_MOSI	0x40000040>,
			   <MX8MN_IOMUXC_ECSPI2_MISO_ECSPI2_MISO	0x0>,
			   <MX8MN_IOMUXC_ECSPI2_SS0_GPIO5_IO13		0x0>;
	};

	pinctrl_fec1: fec1grp {
		fsl,pins = <MX8MN_IOMUXC_ENET_TD2_CCMSRCGPCMIX_ENET_REF_CLK_ROOT	0x10>,
			   <MX8MN_IOMUXC_ENET_TD1_ENET1_RGMII_TD1			0x10>,
			   <MX8MN_IOMUXC_ENET_TD0_ENET1_RGMII_TD0			0x10>,
			   <MX8MN_IOMUXC_ENET_RD1_ENET1_RGMII_RD1			0x40000080>,
			   <MX8MN_IOMUXC_ENET_RD0_ENET1_RGMII_RD0			0x40000080>,
			   <MX8MN_IOMUXC_ENET_RX_CTL_ENET1_RGMII_RX_CTL			0x40000080>,
			   <MX8MN_IOMUXC_ENET_TX_CTL_ENET1_RGMII_TX_CTL			0x10>;
	};

	pinctrl_fec1smi: fec1smigrp {
		fsl,pins = <MX8MN_IOMUXC_ENET_MDC_GPIO1_IO16		0x0>,
			   <MX8MN_IOMUXC_ENET_MDIO_GPIO1_IO17		0x40000040>;
	};

	pinctrl_fec1phy: fec1phygrp {
		fsl,pins = <MX8MN_IOMUXC_ENET_RD2_GPIO1_IO28	0x0>,
			   <MX8MN_IOMUXC_ENET_RD3_GPIO1_IO29	0x40000040>;
	};

	pinctrl_gpio1: gpio1grp {
		fsl,pins = <MX8MN_IOMUXC_GPIO1_IO00_GPIO1_IO0		0x40000040>;
	};

	pinctrl_gpio4: gpio4grp {
		fsl,pins = <MX8MN_IOMUXC_SAI2_RXFS_GPIO4_IO21	0x40000040>,
			   <MX8MN_IOMUXC_SAI2_RXC_GPIO4_IO22	0x40000040>,
			   <MX8MN_IOMUXC_SAI2_RXD0_GPIO4_IO23	0x40000040>,
			   <MX8MN_IOMUXC_SAI2_TXFS_GPIO4_IO24	0x40000040>,
			   <MX8MN_IOMUXC_SAI2_TXC_GPIO4_IO25	0x40000040>,
			   <MX8MN_IOMUXC_SAI2_MCLK_GPIO4_IO27	0x40000040>,
			   <MX8MN_IOMUXC_SAI3_RXFS_GPIO4_IO28	0x40000040>,
			   <MX8MN_IOMUXC_SAI3_RXD_GPIO4_IO30	0x40000040>;
	};

	pinctrl_gpiobutton: gpiobuttongrp {
		fsl,pins = <MX8MN_IOMUXC_SAI3_TXFS_GPIO4_IO31	0x40000040>;
	};

	pinctrl_gpioled: gpioledgrp {
		fsl,pins = <MX8MN_IOMUXC_SAI3_MCLK_GPIO5_IO2		0x0>,
			   <MX8MN_IOMUXC_SPDIF_TX_GPIO5_IO3		0x0>,
			   <MX8MN_IOMUXC_SPDIF_RX_GPIO5_IO4		0x0>,
			   <MX8MN_IOMUXC_SPDIF_EXT_CLK_GPIO5_IO5	0x0>,
			   <MX8MN_IOMUXC_UART4_RXD_GPIO5_IO28		0x0>,
			   <MX8MN_IOMUXC_UART4_TXD_GPIO5_IO29		0x0>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <MX8MN_IOMUXC_I2C1_SCL_I2C1_SCL		0x400001c0>,
			   <MX8MN_IOMUXC_I2C1_SDA_I2C1_SDA		0x400001c0>;
	};

	pinctrl_i2c1_gpio: i2c1gpiogrp {
		fsl,pins = <MX8MN_IOMUXC_I2C1_SCL_GPIO5_IO14	0x400001c0>,
			   <MX8MN_IOMUXC_I2C1_SDA_GPIO5_IO15	0x400001c0>;
	};

	pinctrl_pmic: pmicgrp {
		/* IRQ# */
		fsl,pins = <MX8MN_IOMUXC_GPIO1_IO08_GPIO1_IO8	0x0>;
	};


	pinctrl_tpm: tpmgrp {
		/* TPM_RST# */
		fsl,pins = <MX8MN_IOMUXC_I2C2_SCL_GPIO5_IO16	0x0>,
		/* TPM_PIRQ# */
			   <MX8MN_IOMUXC_I2C3_SCL_GPIO5_IO18	0x40000040>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <MX8MN_IOMUXC_UART1_RXD_UART1_DCE_RX		0x40000040>,
			   <MX8MN_IOMUXC_UART1_TXD_UART1_DCE_TX		0x0>;
	};

	pinctrl_uart2: uart2grp {
		fsl,pins = <MX8MN_IOMUXC_UART2_RXD_UART2_DCE_RX		0x40000040>,
			   <MX8MN_IOMUXC_UART2_TXD_UART2_DCE_TX		0x0>,
			   <MX8MN_IOMUXC_SAI3_RXC_UART2_DCE_CTS_B	0x0>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <MX8MN_IOMUXC_UART3_RXD_UART3_DCE_RX		0x40000040>,
			   <MX8MN_IOMUXC_UART3_TXD_UART3_DCE_TX		0x0>,
			   <MX8MN_IOMUXC_SD1_RESET_B_UART3_DCE_RTS_B	0x40000040>,
			   <MX8MN_IOMUXC_SD1_STROBE_UART3_DCE_CTS_B	0x0>;
	};

	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <MX8MN_IOMUXC_NAND_WE_B_USDHC3_CLK		0x1d0>,
			   <MX8MN_IOMUXC_NAND_WP_B_USDHC3_CMD		0x1d0>,
			   <MX8MN_IOMUXC_NAND_DATA04_USDHC3_DATA0	0x1d0>,
			   <MX8MN_IOMUXC_NAND_DATA05_USDHC3_DATA1	0x1d0>,
			   <MX8MN_IOMUXC_NAND_DATA06_USDHC3_DATA2	0x1d0>,
			   <MX8MN_IOMUXC_NAND_DATA07_USDHC3_DATA3	0x1d0>,
			   <MX8MN_IOMUXC_NAND_RE_B_USDHC3_DATA4		0x1d0>,
			   <MX8MN_IOMUXC_NAND_CE2_B_USDHC3_DATA5	0x1d0>,
			   <MX8MN_IOMUXC_NAND_CE3_B_USDHC3_DATA6	0x1d0>,
			   <MX8MN_IOMUXC_NAND_CLE_USDHC3_DATA7		0x1d0>,
			   <MX8MN_IOMUXC_NAND_CE1_B_USDHC3_STROBE	0x1d0>,
			   <MX8MN_IOMUXC_NAND_READY_B_USDHC3_RESET_B	0x0>;
	};

	pinctrl_usdhc3_100mhz: usdhc3-100mhzgrp {
		fsl,pins = <MX8MN_IOMUXC_NAND_WE_B_USDHC3_CLK		0x1d2>,
			   <MX8MN_IOMUXC_NAND_WP_B_USDHC3_CMD		0x1d2>,
			   <MX8MN_IOMUXC_NAND_DATA04_USDHC3_DATA0	0x1d2>,
			   <MX8MN_IOMUXC_NAND_DATA05_USDHC3_DATA1	0x1d2>,
			   <MX8MN_IOMUXC_NAND_DATA06_USDHC3_DATA2	0x1d2>,
			   <MX8MN_IOMUXC_NAND_DATA07_USDHC3_DATA3	0x1d2>,
			   <MX8MN_IOMUXC_NAND_RE_B_USDHC3_DATA4		0x1d2>,
			   <MX8MN_IOMUXC_NAND_CE2_B_USDHC3_DATA5	0x1d2>,
			   <MX8MN_IOMUXC_NAND_CE3_B_USDHC3_DATA6	0x1d2>,
			   <MX8MN_IOMUXC_NAND_CLE_USDHC3_DATA7		0x1d2>,
			   <MX8MN_IOMUXC_NAND_CE1_B_USDHC3_STROBE	0x1d2>,
			   <MX8MN_IOMUXC_NAND_READY_B_USDHC3_RESET_B	0x0>;
	};

	pinctrl_usdhc3_200mhz: usdhc3-200mhzgrp {
		fsl,pins = <MX8MN_IOMUXC_NAND_WE_B_USDHC3_CLK		0x1d1>,
			   <MX8MN_IOMUXC_NAND_WP_B_USDHC3_CMD		0x1d1>,
			   <MX8MN_IOMUXC_NAND_DATA04_USDHC3_DATA0	0x1d1>,
			   <MX8MN_IOMUXC_NAND_DATA05_USDHC3_DATA1	0x1d1>,
			   <MX8MN_IOMUXC_NAND_DATA06_USDHC3_DATA2	0x1d1>,
			   <MX8MN_IOMUXC_NAND_DATA07_USDHC3_DATA3	0x1d1>,
			   <MX8MN_IOMUXC_NAND_RE_B_USDHC3_DATA4		0x1d1>,
			   <MX8MN_IOMUXC_NAND_CE2_B_USDHC3_DATA5	0x1d1>,
			   <MX8MN_IOMUXC_NAND_CE3_B_USDHC3_DATA6	0x1d1>,
			   <MX8MN_IOMUXC_NAND_CLE_USDHC3_DATA7		0x1d1>,
			   <MX8MN_IOMUXC_NAND_CE1_B_USDHC3_STROBE	0x1d1>,
			   <MX8MN_IOMUXC_NAND_READY_B_USDHC3_RESET_B	0x0>;
	};

	pinctrl_wdog: wdoggrp {
		fsl,pins = <MX8MN_IOMUXC_GPIO1_IO02_WDOG1_WDOG_B	0x0>;
	};
};
